{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  "printWidth": 80,
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "es5",
  "arrowParens": "always",
  "sortPackageJson": false,

  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    ".vitepress/cache",
    ".vitepress/dist",
    ".vitepress/temp",
  ],
}
